# AWS Configuration
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# S3 Configuration
S3_BUCKET=your-entity-resolution-bucket
S3_RAW_PREFIX=raw/
S3_CURATED_PREFIX=curated/
S3_CHECKPOINT_PREFIX=checkpoints/

# Glue Configuration
GLUE_DATABASE=entity_resolution_db
GLUE_JOB_NAME=entity-resolution-job

# Table Names
ICEBERG_TABLE_GOLDEN_RECORDS=golden_records
ICEBERG_TABLE_MATCH_PAIRS=match_pairs
ICEBERG_TABLE_MATCH_EXPLANATIONS=match_explanations

# Matching Configuration
MATCH_THRESHOLD=15.0
REVIEW_THRESHOLD=-5.0

# Logging
LOG_LEVEL=INFO
